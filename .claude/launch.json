{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "amit-olympiad-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "start"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "amit-olympiad-backend-local-db",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "dev:local"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "amit-olympiad-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "amit-olympiad-backend-verify-on",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "dev:local"
      ],
      "port": 8081,
      "autoPort": false,
      "env": {
        "REQUIRE_EMAIL_VERIFICATION": "true"
      }
    },
    {
      "name": "launch-backend-local-db",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "dev:local"
      ],
      "port": 8091,
      "autoPort": false,
      "env": {
        "PORT": "8091",
        "FRONTEND_URL": "http://localhost:5180"
      }
    },
    {
      "name": "launch-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5180"
      ],
      "port": 5180,
      "autoPort": true,
      "env": {
        "API_PROXY_TARGET": "http://localhost:8091"
      }
    },
    {
      "name": "launch-frontend-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "preview:prod",
        "--",
        "--port",
        "5190",
        "--strictPort"
      ],
      "port": 5190,
      "autoPort": false,
      "env": {
        "API_PROXY_TARGET": "http://localhost:8091"
      }
    }
  ]
}
