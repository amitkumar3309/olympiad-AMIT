{
  // Type-check-only config: same compiler options as the build, but also covers
  // tests/ and vitest.config.mts. Never emits, so it can't pollute dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src", "api", "tests", "scripts", "vitest.config.mts"],
  "exclude": ["dist", "node_modules"]
}
