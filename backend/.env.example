# Copy this file to .env and fill in real values. Never commit .env — it is
# gitignored at the repo root. See ENVIRONMENT_VARIABLES.md for full details on
# every variable below, including beginner-friendly setup instructions.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Local dev server port (matches .claude/launch.json)
PORT=8081

# development | production | test — leave as development locally.
NODE_ENV=development

# MongoDB Atlas connection string (or a local MongoDB). Must be set in
# production — there is no safe production fallback.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/amit-olympiad

# Long random string used to sign access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production — the server refuses to start without it.
JWT_SECRET=replace-with-a-long-random-string

# The deployed frontend's URL. Used for CORS *and* as the base for the links in
# verification / password-reset emails, so set it correctly or those links will
# point at the wrong host. Optional locally (defaults to http://localhost:5173).
FRONTEND_URL=https://your-frontend.vercel.app

# ---------------------------------------------------------------------------
# Admin account (single account, no signup flow — see DECISIONS.md)
# ---------------------------------------------------------------------------

# ADMIN_PASSWORD_HASH must be a bcrypt hash, never a plaintext password:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ADMIN_EMAIL=amitkumar3309@gmail.com
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

# ---------------------------------------------------------------------------
# Token lifetimes and auth policy (all optional — sensible defaults shown)
# ---------------------------------------------------------------------------

# Access-token lifetime. Short by design: revocation takes effect within this
# window. Accepts any ms-style duration ('15m', '1h').
ACCESS_TOKEN_TTL=15m

# Refresh-token lifetime in days. Rotated on every use.
REFRESH_TOKEN_TTL_DAYS=30

# ADMIN_TOKEN_TTL was removed in Milestone 11. The super administrator now has a
# database account and a rotating refresh token like everybody else, so it uses
# ACCESS_TOKEN_TTL above. Leaving the old variable set anywhere is harmless — it is
# simply ignored.

# Whether students must click the emailed link before they can sign in.
# Set to false only if email delivery is broken and you need a way in.
REQUIRE_EMAIL_VERIFICATION=true

# Failed logins before an account is temporarily locked, and for how long.
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# ---------------------------------------------------------------------------
# Email / SMTP
# ---------------------------------------------------------------------------
# Any SMTP provider works — Brevo, Resend, Mailtrap, or a Gmail app password.
# Leave these unset during local development: emails (including the verification
# and reset links) are written to the server log instead of being sent, so the
# flows remain fully testable without a provider.
#
# Values below are for Brevo's free tier as an example; see
# ENVIRONMENT_VARIABLES.md for step-by-step signup instructions.

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login@smtp-brevo.com
SMTP_PASS=replace-with-your-smtp-key
# true only for implicit TLS on port 465; leave false for 587 (STARTTLS).
SMTP_SECURE=false

# The From address recipients see. Must be an address/domain your provider has
# authorised, or your mail will be rejected or land in spam.
EMAIL_FROM=AMIT Olympiad <amitkumar3309@gmail.com>

# ---------------------------------------------------------------------------
# Performance recommendations (Milestone 16)
# ---------------------------------------------------------------------------
# Which recommendation engine to use. The default is statistical — it counts the
# student's own answered questions and compares them with confidence intervals.
# It needs no credentials, no network access and no paid service, so the MVP
# runs on it with this line absent entirely.
#
# Set this only if you have registered another engine in code (see
# backend/src/lib/recommendationTypes.ts). An unknown value is not fatal: the
# service logs a warning once and falls back to the statistical engine.
RECOMMENDATION_ENGINE=statistical-v1

# ---------------------------------------------------------------------------
# AI question drafting (Milestone 17, extended in Milestone 20) — OPTIONAL
# ---------------------------------------------------------------------------
# EVERY OTHER FEATURE WORKS WITHOUT THIS. With no key, the admin "AI Question
# Generator" page says it is not configured and refuses; it does NOT invent
# filler questions. Nothing else in the product calls a model.
#
# Get a key at https://aistudio.google.com/apikey (free tier, no card required).
# See ENVIRONMENT_VARIABLES.md for step-by-step instructions and for how to
# check that the backend can reach Google.
#
# NO STUDENT DATA IS EVER SENT to it: the request contains a subject name,
# chapter names, an optional subtopic name, a class, a difficulty, the marks and
# whatever instruction you typed. There is a test asserting this.
GEMINI_API_KEY=

# Which Gemini model to call.
# Leave as the rolling alias unless you need a pinned version: Google retires
# exact model names on their own schedule, and the alias tracks the current one.
# The admin page's "Which models can my key use?" button asks your key directly,
# so the name never has to be guessed.
GEMINI_MODEL=gemini-flash-latest

# Which registered generator the admin button uses. "auto" (the default) means
# "the first configured provider", so the key alone turns the feature on and off.
# Set an explicit id only if you have registered a second provider in code — see
# backend/src/lib/questionGeneratorTypes.ts.
QUESTION_GENERATOR=auto

# How many EXTRA attempts a transient provider failure earns (0-3).
# Only 429, 5xx and timeouts are retried at all; an expired key or a retired
# model name is permanent, and repeating it spends quota for the same refusal.
GEMINI_MAX_RETRIES=1

# Cost controls. Lower these on a tighter quota; they are enforced server-side,
# so the browser cannot exceed them whatever the form allows.
# Most questions one generation request may ask for (1-20).
GENERATION_MAX_QUESTIONS=20
# Longest "extra instructions" an examiner may attach, in characters (50-2000).
GENERATION_MAX_INSTRUCTION_CHARS=500
# Generation requests allowed per hour, per IP. Each one spends provider quota.
GENERATION_RATE_LIMIT_PER_HOUR=60

# ---------------------------------------------------------------------------
# Payments — Razorpay (Milestone 19)
# ---------------------------------------------------------------------------
# Get these from https://dashboard.razorpay.com → switch to TEST MODE →
# Account & Settings → API Keys → Generate Test Key.
#
# KEY_ID is public (the browser needs it to open the checkout) but is served
# from the backend rather than bundled, so the two can never drift apart.
# KEY_SECRET must never leave the server. Never commit either.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-test-key-secret

# A long random string YOU invent, then paste into Razorpay's dashboard when
# creating the webhook. Deliberately separate from KEY_SECRET: Razorpay signs
# webhooks with this one, and a webhook verified against the API secret would
# be checking the wrong thing.
#   Webhook URL:    https://<your-backend>.vercel.app/api/v1/payments/webhook
#   Active events:  payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=replace-with-a-long-random-string

# NOTE: the entry FEE is NOT here. It is business configuration, not a
# credential, so it lives in an admin-editable settings document and is changed
# from the admin panel rather than by redeploying. The paid gate is also OFF by
# default — an administrator switches it on once checkout is proven to work.
