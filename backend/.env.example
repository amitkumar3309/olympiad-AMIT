# Copy this file to .env and fill in real values. Never commit .env — it is
# gitignored at the repo root. See ENVIRONMENT_VARIABLES.md for full details
# on every variable below, including beginner-friendly setup instructions.

# Local dev server port (matches .claude/launch.json)
PORT=8081

# development | production | test — leave as development locally.
NODE_ENV=development

# MongoDB Atlas connection string (or a local MongoDB). Must be set in
# production — there is no safe production fallback.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/amit-olympiad

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production — the server refuses to start without it.
JWT_SECRET=replace-with-a-long-random-string

# The single admin account. ADMIN_PASSWORD_HASH must be a bcrypt hash, never
# a plaintext password — generate it with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

# The deployed frontend's production URL (used for CORS). Optional locally —
# localhost:5173 is always allowed.
FRONTEND_URL=https://your-frontend.vercel.app
